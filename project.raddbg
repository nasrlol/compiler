// raddbg 0.9.30 project file

name: compiler
target:
{
  executable: "build/compiler"
  working_directory: "../compiler"
  label: compiler
}
target:
{
  executable: "build/test"
  working_directory: "../compiler"
  label: test
}
watch_pin:
{
  expression: "#ifdef BASE_IMPLEMENTATION"
  source_location: "source/base/base_string.h:85:1"
}
watch_pin:
{
  expression: nil_token_node
  source_location: "source/code/lexer.h:103:1"
}
target:
{
  executable: "tests/main.jr"
  working_directory: tests
}
target:
{
  executable: "build/compiler"
  working_directory: "../compiler"
  enabled: 1
  arguments: "--source=./tests/main.jr"
  output_label: output
  label: "compiler with arguments"
}
