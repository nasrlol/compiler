 bar(point: s32) int | ! {

 numbers: s32[5] = [1, 3, 5, 6]

 for x in numbers {
 if x == point {
 print(x)
 }
 }

 while true {
 point += 1
 }
 }

 main(x : s32, y: s32, z: s64) int | string {

 foo(4, 5);
 result: u64 = x + y + z
 return {4, "Hello World", 9}
 }


 baz(x: int) {

 switch x
 {
 case: {
 x = 1
 }

 case: {
 x -= 1
 }

 case: {
 x += 1
 }
 }
 }

 foo(x: s32, y: s32) ! {
 x += 5;
 return !;
}
