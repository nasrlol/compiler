version(2);
project_name = "compiler";
patterns = {
    "*.c",
    "*.cpp",
    "*.h",
    "*.m",
    "*.bat",
    "*.sh",
    "*.4coder",
    "*.jr",
};

blacklist_patterns = {
    ".*",
};

 paths = {
    { "./source/code",     .relative = true, .recursive = true, },
    { "./source/base",     .relative = true, .recursive = true, },
};

load_paths = {
.win = paths,
.linux = paths,
.mac = paths,
};

commands = {
    .run      = { .linux = "./build/compiler", .mac = "./build.sh", .out = "*compilation*", .footer_panel = true, .save_dirty_files = true,  .cursor_at_end = true,  },
    .build    = { .linux = "./build.sh", .mac = "./build.sh", .out = "*compilation*", .footer_panel = true, .save_dirty_files = true,  .cursor_at_end = true,  },
};


fkey_command = {
    .F1 = "build",
    .F2 = "run",
};

